{
  "name": "bittrees-gov",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "release:gate": "node scripts/release-gate.mjs",
    "test:release-gate": "node --test scripts/release-gate.test.mjs",
    "test:unit": "node --test src/lib/routeMeta.test.ts src/lib/chatRecoveryExport.test.ts src/lib/pushSessionCore.test.ts src/lib/pushSessionWallet.test.ts",
    "test:recovery-browser": "playwright test -c playwright.recovery.config.ts",
    "test:push-browser": "playwright test -c playwright.push.config.ts",
    "postinstall": "patch-package --error-on-fail",
    "prebuild": "patch-package --error-on-fail",
    "pretest:push-sdk-browser": "patch-package --error-on-fail",
    "test:push-sdk-browser": "playwright test -c playwright.push-sdk.config.ts",
    "test:app-recovery": "playwright test -c playwright.app-recovery.config.ts",
    "test:dependency-audit": "npm audit --audit-level=high",
    "test:uuid-compatibility": "node --test scripts/uuid-compatibility.test.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@pushprotocol/restapi": "1.7.32",
    "@rainbow-me/rainbowkit": "2.2.3",
    "@tanstack/react-query": "5.75.5",
    "@xmtp/browser-sdk": "^7.0.0",
    "ethers": "^6.16.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router": "^7.18.2",
    "viem": "2.28.1",
    "vite-plugin-node-polyfills": "^0.28.0",
    "wagmi": "2.15.4"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@tailwindcss/vite": "4.1.8",
    "@tanstack/react-query-devtools": "5.75.5",
    "@types/react": "19.1.5",
    "@types/react-dom": "19.1.3",
    "@vitejs/plugin-react": "4.5.0",
    "patch-package": "^8.0.1",
    "tailwindcss": "4.1.8",
    "typescript": "5.8.3",
    "vite": "6.4.3"
  },
  "overrides": {
    "@pushprotocol/restapi": {
      "axios": "0.33.0",
      "uuid": "11.1.1"
    },
    "ws@>=8.0.0 <8.21.0": "8.21.0",
    "postcss@>=8.0.0 <8.5.23": "8.5.23",
    "nanoid@>=3.0.0 <3.3.18": "3.3.18",
    "browserslist@>=4.0.0 <4.28.7": "4.28.7",
    "baseline-browser-mapping@>=2.0.0 <2.11.0": "2.11.0",
    "socket.io-parser@>=4.0.0 <4.2.7": "4.2.7",
    "qs@>=6.0.0 <6.16.0": "6.16.0",
    "joi@>=17.0.0 <17.13.6": "17.13.6",
    "@wagmi/connectors": {
      "@metamask/sdk": {
        ".": "0.33.1",
        "uuid": "11.1.1"
      }
    },
    "@metamask/sdk-communication-layer": {
      "uuid": "11.1.1"
    },
    "@metamask/utils": {
      "uuid": "11.1.1"
    }
  }
}
